// CleanWizard — Release.xcconfig  (archive, signing, distribution)
#include "Shared.xcconfig"

// MARK::Optimization
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s
ENABLE_NS_ASSERTIONS = NO
ENABLE_TESTABILITY = NO

// MARK::Rust profile
// Release configuration links the Rust staticlib's optimized profile.
CLEANWIZARD_RUST_PROFILE = release
